# SquadLogic — Environment Variables Template
# Copy this file to .env and fill in your values.
# See .env.local.example for secrets that must NOT be committed.
#
# Every VITE_ variable is inlined into the browser bundle at build time, so
# none may hold a secret. frontend/src/env.js reads and validates each one by
# name; a production build (`npm run frontend:build`) with a missing or
# malformed one fails, naming it. Reference: docs/operations/ENVIRONMENT.md.
# ------------------------------------------------------------

# ── Supabase project URL (safe to commit) ────────────────────
# Supabase → Settings → API → Project URL, e.g. https://<project-ref>.supabase.co
# Required in a production build unless VITE_USE_MOCK_SUPABASE=true.
# Left empty, the dev server (`npm run frontend:dev`) runs the mock client.
VITE_SUPABASE_URL=

# ── Publishable key (safe to commit) ─────────────────────────
# Use the PUBLISHABLE key from Supabase → Settings → API.
# This key enforces Row Level Security and is safe to ship in
# the browser bundle. Never put the Secret key here: a build refuses
# an sb_secret_ key or a service_role JWT in this variable.
# Required in a production build unless VITE_USE_MOCK_SUPABASE=true.
VITE_SUPABASE_ANON_KEY=

# ── Mock client opt-in ───────────────────────────────────────
# 'true' runs the sessionStorage mock instead of Supabase, and is the only way
# a production build ships the mock (Playwright and CI's E2E set it).
# Unset or 'false' in every deployed environment.
# VITE_USE_MOCK_SUPABASE=true

# ── Persistence Edge Functions base (optional) ───────────────
# Defaults to VITE_SUPABASE_URL + /functions/v1, or to the local stack
# (http://localhost:54321/functions/v1) when VITE_SUPABASE_URL is unset.
# VITE_SUPABASE_PERSISTENCE_URL=https://<project-ref>.supabase.co/functions/v1

# ── Observability (Phase 9 — optional, free tiers) ───────────
# Sentry DSN for frontend error tracking. Unset: Sentry is off.
# A malformed DSN fails the build.
# Get yours at https://sentry.io → Create Project → Browser JavaScript.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# BetterStack (Logtail) source token for Edge Function logging.
# Get yours at https://logs.betterstack.com → Sources → Create Source.
# Set this in Supabase Dashboard → Edge Functions → Environment Variables.
# BETTERSTACK_SOURCE_TOKEN=your_betterstack_source_token

# ── Test credentials (used by E2E/Playwright against a real backend) ──
# See .env.test.example: TEST_* names, read at the Node layer, never VITE_.
