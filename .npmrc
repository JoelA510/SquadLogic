# Install guards (M2.3; standard node.install-guards). npm 11.15 or later reads all three, which
# is why package.json pins npm in packageManager; npm 10 ignores them. None changes what `npm ci`
# installs: that comes from package-lock.json as it is. Policy: docs/security/dependency-policy.md.

# Choose only releases at least 3 days old when npm picks a version (npm install, npm update,
# npm audit fix), the same wait Dependabot keeps (.github/dependabot.yml). A compromised release
# is usually caught and pulled within days. To take an urgent fix younger than that, once the
# owner approves it and the pull request says so: npm install <pkg>@<version> --min-release-age=0
min-release-age=3

# No git or tarball-URL dependency anywhere in the tree, ours or a dependency's: everything comes
# from the registry. A git dependency skips the registry and its wait entirely (the route
# TanStack's compromised packages used, May 2026).
allow-git=none
allow-remote=none
