{
  "name": "squad-logic",
  "version": "1.0.1",
  "description": "An application that converts raw GotSport registration data in CSV format and provides both teaming and scheduling frameworks, intended to support youth sports organizations.",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=1",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/performance.test.js",
    "test:perf": "vitest run tests/performance.test.js",
    "build": "npm run frontend:build",
    "frontend:dev": "vite",
    "frontend:build": "node scripts/runViteWithPersistenceEndpoint.js build",
    "frontend:preview": "node scripts/runViteWithPersistenceEndpoint.js preview",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle-size.js",
    "check:advisors": "node scripts/advisor-lint.js",
    "check:audit": "node scripts/check-audit.mjs",
    "check:unused": "knip",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "test:db": "supabase test db",
    "test:db:once": "supabase test db supabase/tests/_fixtures.sql",
    "test:db:local": "bash scripts/dbharness/run.sh",
    "test:db:local:prove": "bash scripts/dbharness/prove.sh",
    "test:db:local:prove:anchors": "PLANT_ANCHORS_ONLY=1 bash scripts/dbharness/prove.sh",
    "test:db:local:prove:mock": "node scripts/dbharness/prove-mock.mjs"
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@tanstack/react-virtual": "3.13.23",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.58.0",
    "papaparse": "^5.5.3",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "~6.41.0",
    "playwright-bdd": "^9.0.0",
    "postcss": "^8.5.29",
    "prettier": "3.7.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "fsevents": false
  }
}
